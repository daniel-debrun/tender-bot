# tender-heartbeats: Heartbeat watchdog for the tender-bot jobs
# Install (after review): see live/tender_bot/README.md "Scheduling". Logs: journalctl --user -u tender-heartbeats
[Unit]
Description=tender-bot: Heartbeat watchdog for the tender-bot jobs
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/tender-bot
Environment=PYTHONUNBUFFERED=1
Environment=DISPLAY=:0
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus
# job-guard failures (exit 1/3/4/6) alert through ibkr-ops; offer notifications use notify-send directly
Environment="IBKR_OPS_ALERT_CMD=notify-send -u critical tender-bot-job"
ExecStart=/usr/bin/timeout -k 30 120 %h/tender-bot/.venv/bin/python -m ibkr_ops heartbeats tender-scan=2 tender-deadline=96 tender-trade-am=96 tender-trade-entries=96 tender-summary=96 --alert
