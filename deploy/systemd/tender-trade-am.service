# tender-trade-am: Morning trade run: requested sells, terminations, unaccepted remainders (paper orders)
# Install (after review): see live/tender_bot/README.md "Scheduling". Logs: journalctl --user -u tender-trade-am
[Unit]
Description=tender-bot: Morning trade run: requested sells, terminations, unaccepted remainders (paper orders)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/tender-bot
Environment=PYTHONUNBUFFERED=1
Environment=DISPLAY=:0
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus
# job-guard failures (exit 1/3/4/6) alert through ibkr-ops; offer notifications use notify-send directly
Environment="IBKR_OPS_ALERT_CMD=notify-send -u critical tender-bot-job"
ExecStart=/usr/bin/timeout -k 30 900 %h/tender-bot/.venv/bin/tender_bot trade --place
